import instaloader

LOGIN_USER = 'alber.tazzi'
TARGET_USER = 'el.bhdr'
SESSION_PATH = "/Users/enricomagni/.config/instaloader/session-alber.tazzi"

L = instaloader.Instaloader()
L.load_session_from_file(LOGIN_USER, SESSION_PATH)

profile = instaloader.Profile.from_username(L.context, TARGET_USER)
with open(f"{TARGET_USER}_following.txt", "w", encoding="utf-8") as f:
    for followee in profile.get_followees():
        f.write(f"{followee.username}\n")

print(f"Done! All users that {TARGET_USER} follows are saved to {TARGET_USER}_following.txt")
